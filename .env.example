# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite (default — no setup required):
DATABASE_URL=sqlite+aiosqlite:///./orders.db

# Supabase PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# ─── Authentication ───────────────────────────────────────────────────────────
# Change this to a long random string in production
API_KEY=dev-api-key-change-me

# ─── OpenAI — enables GPT-4o-mini for accurate PDF extraction ─────────────────
# Leave blank to fall back to regex-based extraction
OPENAI_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=MedOrders API
VERSION=1.0.0

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins, or ["*"] for open access during dev
ALLOWED_ORIGINS=["*"]

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# The API key used by the browser to authenticate with the backend
NEXT_PUBLIC_API_KEY=dev-api-key-change-me
